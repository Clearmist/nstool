{
  "name": "nstool Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/nstool",
  "remoteUser": "vscode",
  "postCreateCommand": "git submodule update --init --recursive || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake"
      ],
      "settings" : {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "containerEnv": {
    "ROOT_PROJECT_NAME": "nstool",
    "ROOT_PROJECT_PATH": "/workspaces/nstool"
  },
  "mounts": [],
  "forwardPorts": []
}